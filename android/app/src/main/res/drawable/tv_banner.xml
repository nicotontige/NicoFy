<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180 dp): the app icon on its background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher_adaptive_fore" />
</layer-list>
